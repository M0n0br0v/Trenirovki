        </mxCell>
        <mxCell id="nQ0QAQUby_pZ3yXj51tU-477" value="&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;Если упражнения&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;не указаны,&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;надпись:&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;text-wrap-mode: nowrap; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&quot;Выбрать&quot;.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;fontFamily=Comic Sans MS;fontSize=11;fontColor=default;labelBackgroundColor=none;verticalAlign=middle;sketch=1;curveFitting=1;jiggle=2;align=center;strokeColor=none;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;container=0;" parent="1" vertex="1">
